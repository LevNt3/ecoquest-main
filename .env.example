# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY=

# APP_URL: The public URL where this applet is hosted.
APP_URL=http://localhost:3000

# OPENROUTER_API_KEY: Server-side API key for OpenRouter vision verification (never expose to client).
OPENROUTER_API_KEY=

# OPENROUTER_MODEL: Configurable OpenRouter model ID (defaults to free router for vision).
OPENROUTER_MODEL=openrouter/free

# OPENROUTER_SITE_URL: Optional referer URL sent to OpenRouter.
OPENROUTER_SITE_URL=http://localhost:3000

# OPENROUTER_APP_NAME: App identifier sent in X-Title header to OpenRouter.
OPENROUTER_APP_NAME=EcoQuest

# ADMIN_PASSCODE: Optional server-side passcode to claim/unlock admin role in Settings.
ADMIN_PASSCODE=
