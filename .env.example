# APP_URL: The public URL where this applet is hosted.
APP_URL=http://localhost:3000

# SESSION_SECRET: Required in production for signing HTTP-only session cookies.
SESSION_SECRET=

# ADMIN_PASSCODE: Required in production to promote an account to Admin in Settings.
ADMIN_PASSCODE=

# CLOUDFLARE_ACCOUNT_ID: Server-side Cloudflare Account ID for Workers AI.
CLOUDFLARE_ACCOUNT_ID=

# CLOUDFLARE_API_TOKEN: Server-side Cloudflare API token with Workers AI Read/Run permission.
CLOUDFLARE_API_TOKEN=

# CLOUDFLARE_AI_MODEL: Configurable Cloudflare Workers AI vision model ID.
CLOUDFLARE_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
